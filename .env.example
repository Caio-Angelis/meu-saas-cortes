GROQ_API_KEY=sua_chave_groq_aqui

# TTS realista (aba Text-to-Speech / voz ★ Achernar na GUI) — Google Gemini API
# Obtenha em https://aistudio.google.com/apikey
# GEMINI_API_KEY=sua_chave_gemini_aqui
# Modelo TTS (use um modelo *-tts*; o código tenta fallbacks se falhar):
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE_PT=Achernar
# GEMINI_HTTP_TIMEOUT_SEC=180

# TTS local (Kokoro — roda na GPU, incl. RTX 50xx). Instale: bash scripts/install_local_tts.sh
# LOCAL_TTS_DEVICE=auto
# LOCAL_TTS_VOICE_PT=pf_dora
# LOCAL_TTS_SPEED=1.0
# LOCAL_TTS_PREFERRED=1
# Pedidos Groq em paralelo (Whisper fatiado + análise viral partilham o mesmo semáforo).
# Se vir 429 nas transcrições, use 1 ou 2 — não aumente GROQ_TRANSCRIBE_MAX_WORKERS sem aumentar quota.
# GROQ_MAX_IN_FLIGHT=2
# GROQ_TRANSCRIBE_MAX_WORKERS=2

# Transcrição: local (GPU, rápido, dá timestamp por palavra) ou groq (nuvem)
# TRANSCRIBE_BACKEND=local
# LOCAL_WHISPER_MODEL=large-v3
# LOCAL_WHISPER_COMPUTE=float16

OUTPUT_DIR=resultados
TEMP_DIR=temp
CLIP_DURATION=50
VIRAL_CLIPS_COUNT=5
CLIP_SPEED_UP_PERCENT=2

# Legendas queimadas no vídeo (9:16). Aumente TIKTOK_SUBTITLE_MARGIN_V se ainda encobrir o @ no TikTok.
# TIKTOK_SUBTITLE_FONT_SIZE=40
# TIKTOK_SUBTITLE_MARGIN_V=88
# TIKTOK_SUBTITLE_MARGIN_LR=56

SMART_CROP_ENABLED=1
SMART_CROP_FRAME_SAMPLES=12
# Com 2 pessoas no quadro: amostras/seg para seguir boca (falante); mais alto = mais CPU
# SMART_CROP_SPEAKER_FPS=4
# Segundos mínimos entre uma troca de foco (crop) e outra
# SMART_CROP_MIN_CHANGE_INTERVAL_SEC=3
# MediaPipe FaceDetector: com driver NVIDIA no Linux, a GPU é usada por padrão (auto).
# Desligar: SMART_CROP_MEDIAPIPE_GPU=0. Sem NVIDIA, SMART_CROP_MEDIAPIPE_GPU=1 é ignorado (CPU).
# Para insistir na GPU em AMD+Mesa (pode falhar): SMART_CROP_MEDIAPIPE_GPU_FORCE=1
# SMART_CROP_MEDIAPIPE_GPU=1
# SMART_CROP_MEDIAPIPE_GPU_FORCE=1

# Encode de clipes no Linux: se CLIP_GPU_ENCODER não for definido, o projeto escolhe:
#   NVIDIA (ex.: RTX 5060 Ti) → h264_nvenc
#   AMD/Mesa (ex.: RX 5500 XT) → h264_vaapi quando o FFmpeg listar; senão h264_amf
# RTX 16 GB: CLIP_ENCODE_PARALLEL_GPU=3 ou 4 costuma ser seguro em 1080×1920.
# CLIP_GPU_ENCODER=h264_nvenc
# CLIP_ENCODE_PARALLEL_GPU=4
# VA-API (só AMD): sem VAAPI_RENDER_NODE, o código prefere o /dev/dri/renderD* de MAIOR índice
# se houver 2+ (ignora iGPU integrada). Se errado no teu hardware, fixa manualmente:
# VAAPI_RENDER_NODE=/dev/dri/renderD129

# Dublagem: cortar silêncio longo (vídeo+áudio); desligar evita "pulos" de imagem entre falas
# DUB_TRIM_SILENCE=1
# DUB_SILENCE_CUT_MIN_SEC=0.85
# DUB_SILENCE_DETECT_DB=-40
# TTS mais longo que o slot: acelerar até Nx (atempo) antes de cortar o excesso
# DUB_MAX_TTS_SPEEDUP=4.0

# Tradução (Google via deep-translator): 1 agrupa vários segmentos por requisição; se a
# resposta não bater com o número de partes ou o texto tiver caracteres raros, volta ao 1:1.
# TRANSLATE_BATCH=0
# TRANSLATE_BATCH_MAX_CHARS=3800

# ── Desempenho / benchmark (mantém presets de encode atuais) ─────────────────
# Medições de parede útil: segunda execução costuma ganhar pela cache em ~/.cache/meu_saas_cortes
# (segmentos/momentos/traduções por clipe/planos de crop). Cache frio: rm -rf esse diretório ou use
# outra pasta com CACHE_DIR=/tmp/seu_teste_cache e apague antes do cronômetro.
#
# Cronometrar (bash): salve vídeo/ref.mp4 e rode o seu entrypoint com time, ex.:
#   time python3 main.py ref.mp4
# Anote: tempo total, número de clipes, SMART_CROP_* e GROQ_TRANSCRIBE_MAX_WORKERS; repita
# após mudar estas variáveis para comparar.
#
# Crédito na legenda .txt ao baixar por URL (yt-dlp): canal do YouTube, etc.
# CAPTION_SOURCE_ATTRIBUTION=1
# CAPTION_SOURCE_LINE_PT=Review original: {channel}
# CAPTION_SOURCE_LINE_EN=Original review: {channel}

# ── Bot Telegram (telegram_bot.py) — aciona quiz no PC local ───────────────
# Crie o bot com @BotFather e obtenha o token. Seu ID numérico: fale com @userinfobot.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
# TELEGRAM_ALLOWED_USER_ID=123456789

# ── Interface web (web_main.py) + fila RQ ───────────────────────────────────
# Sem REDIS_URL os jobs rodam em thread no processo do servidor (dev local).
# Com Redis: suba o worker em outro terminal: .venv/bin/python web_worker.py
# REDIS_URL=redis://127.0.0.1:6379/0
# RQ_QUEUE_NAME=cortes

# Se CPU “trava”: reduza SMART_CROP_FRAME_SAMPLES, SMART_CROP_SPEAKER_FPS e/ou
# PIPELINE_CPU_PER_CLIP_ESTIMATE (ou fixe PIPELINE_MAX_WORKERS). Veja também CLIP_ENCODE_* e
# USE_GPU_CLIP_ENCODE no config comentado acima.

# Download: nº de fragmentos em paralelo por vídeo (mais rápido em DASH/HLS)
# YTDLP_CONCURRENT_FRAGMENTS=4
